{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gasti Developers",
  "colors": {
    "primary": "#093505",
    "light": "#D3FF0A",
    "dark": "#D3FF0A"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#050505"
    }
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Anek Odia",
      "weight": 700
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Empezar",
        "pages": [
          "introduccion",
          "conectar-mi-gasti",
          "registrar-integracion"
        ]
      },
      {
        "group": "Autenticación",
        "pages": [
          "oauth/flujo",
          "oauth/scopes",
          "oauth/tokens-y-refresh",
          "oauth/errores"
        ]
      },
      {
        "group": "API Reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "logo": {
    "light": "/logo/gasti.png",
    "dark": "/logo/gasti.png",
    "href": "https://gasti.pro"
  },
  "navbar": {
    "links": [
      {
        "label": "gasti.pro",
        "href": "https://gasti.pro"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Abrir Gasti",
      "href": "https://app.gasti.pro"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/gasti_pro",
      "instagram": "https://www.instagram.com/gasti_pro/",
      "linkedin": "https://www.linkedin.com/company/gastipro/"
    }
  }
}
